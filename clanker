#!/usr/bin/env bash
# clanker - Drop into an isolated agent environment for the current project
set -euo pipefail


# ─── Configuration ───────────────────────────────────────────
# This script lives in the clanker repo. It finds its own directory
# to locate the Dockerfile and supporting files.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Script version
VERSION_FILE="${SCRIPT_DIR}/.version"
if [[ -f "${VERSION_FILE}" ]]; then
    VERSION="$(cat "${VERSION_FILE}")"
else
    VERSION="$(git -C "${SCRIPT_DIR}" rev-parse --short HEAD 2>/dev/null || echo "dev")"
fi

# Implement a version argument
if [[ "${1:-}" == "--version" ]]; then
    echo "clanker ${VERSION}"
    echo "repo: ${SCRIPT_DIR}"
    echo "image: ${IMAGE_TAG}"
    exit 0
fi

IMAGE_TAG="clanker:latest"
CONTAINER_NAME="clanker-$(date +%Y%m%d-%H%M%S)-$$"

# Paths that exist on the host
PROJECT_ROOT="${CLANKER_PROJECT:-$(pwd)}"

SKILLS_DIR="${CLANKER_SKILLS_DIR:-${PROJECT_ROOT}/.clanker}"
GLOBAL_SKILLS="${SCRIPT_DIR}/skills"
SECRETS_DIR="${CLANKER_SECRETS_DIR:-${HOME}/.config/clanker/secrets}"
CLANKER_CACHE="${CLANKER_CACHE:-${HOME}/.cache/clanker}"

# ─── Preflight ───────────────────────────────────────────────
if [[ ! -d "${PROJECT_ROOT}" ]]; then
    echo "Error: PROJECT_ROOT ${PROJECT_ROOT} does not exist" >&2
    exit 1
fi

if [[ ! -f "${PROJECT_ROOT}/.git" ]] && [[ ! -d "${PROJECT_ROOT}/.git" ]]; then
    echo "Warning: Not a git repository. Proceeding anyway." >&2
fi

# ─── Prepare mounts ──────────────────────────────────────────
# Create host directories if they don't exist
mkdir -p "${CLANKER_CACHE}/pip"
mkdir -p "${CLANKER_CACHE}/npm"
mkdir -p "${SECRETS_DIR}"

# ─── Mount options ───────────────────────────────────────────
# Add some basic Darwin support 

if [[ "$(uname)" == "Darwin" ]]; then
	MOUNT_OPTS=":delegated"
else
	MOUNT_OPTS=""
fi

MOUNTS=(
    # Project: read-write so the agent can edit files
    -v "${PROJECT_ROOT}:/workspace:rw${MOUNT_OPTS}"

    # Package caches: persist between sessions
    -v "${CLANKER_CACHE}/pip:/home/clanker/.cache/pip:rw"
    -v "${CLANKER_CACHE}/npm:/home/clanker/.cache/npm:rw"

    # Skills: project-specific override global
    -v "${GLOBAL_SKILLS}:/etc/clanker/skills:ro"
)

# If project has .clanker/skills, mount it over the global skills
if [[ -d "${SKILLS_DIR}/skills" ]]; then
    MOUNTS+=(-v "${SKILLS_DIR}/skills:/workspace/.clanker/skills:ro")
fi

# If project has .clanker/config, mount it
if [[ -f "${SKILLS_DIR}/config" ]]; then
    MOUNTS+=(-v "${SKILLS_DIR}/config:/workspace/.clanker/config:ro")
fi

# If .venv exists on host shadow it with a container-local volume 
if [[ -d "${PROJECT_ROOT}/.venv" ]]; then 
	MOUNTS+=(-v "clanker-venv-$(basename ${PROJECT_ROOT}):/workspace/.venv")
fi

# ─── Secrets handling ────────────────────────────────────────
# We never pass secrets via environment variables.
# Instead, we mount a tmpfs with the provider key file.
SECRET_MOUNT="--tmpfs /run/secrets:mode=0700,size=1M"

# If a provider key exists on the host, copy it to a temp file and mount
PROVIDER_KEY_FILE="${CLANKER_PROVIDER_KEY_FILE:-${SECRETS_DIR}/provider.key}"
if [[ -f "${PROVIDER_KEY_FILE}" ]]; then
    TMP_KEY="$(mktemp)"
    trap "rm -f ${TMP_KEY}" EXIT
    cp "${PROVIDER_KEY_FILE}" "${TMP_KEY}"
    MOUNTS+=(-v "${TMP_KEY}:/run/secrets/provider.key:ro")
fi

# ─── Network ─────────────────────────────────────────────────
# No network by default. The agent reaches the provider through
# the socket proxy running on the host.
NETWORK="--network none"
SOCKET_MOUNT=""

# If a provider socket proxy is available, mount it
PROVIDER_SOCKET="${CLANKER_PROVIDER_SOCKET:-${HOME}/.cache/clanker/provider.sock}"

if [[ -S "${PROVIDER_SOCKET}" ]]; then
    SOCKET_MOUNT="-v ${PROVIDER_SOCKET}:/var/run/provider.sock:rw"
	echo " Provider:   socket connected"
elif [[ "${CLANKER_ALLOW_NETWORK:-0}" == "1" ]]; then
    # Fallback: allow network access if explicitly enabled
    NETWORK="--network host"
else
	echo " Provider:   OFFLINE (start provider-proxy on host)"
fi


# Resolve real path (handles symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "${SCRIPT_PATH}" ]; do
    SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" >/dev/null 2>&1 && pwd)"
    SCRIPT_PATH="$(readlink "${SCRIPT_PATH}")"
    [[ ${SCRIPT_PATH} != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
SCRIPT_DIR="$(cd -P "$(dirname "${SCRIPT_PATH}")" >/dev/null 2>&1 && pwd)"

# The proxy binary lives alongside the repo (built by make)
PROXY_BINARY="${SCRIPT_DIR}/target/release/clanker-provider-proxy"

# ─── Auto-start provider if proxy isn't running ──────────────
if [[ ! -S "${PROVIDER_SOCKET}" ]]; then
	echo "Provider proxy not running, attempting to start..." >&2

	if [[ -x "${PROXY_BINARY}" ]]; then 
		# Start in background
		nohup "${PROXY_BINARY}" > /dev/null 2>&1 & 
		PROXY_PID=$!

		# Wait for socket to appear
		for i in {1..50}; do 
			if [[ -S "${PROVIDER_SOCKET}" ]]; then 
				echo "Provider proxy started with (PID ${PROXY_PID})" >&2 
				break
			fi 
			sleep 0.1
		done

		if [[ -S "${PROVIDER_SOCKET}" ]]; then
			echo "ERROR: provider proxy failed to start" >&2
			echo "Run 'make proxy && make install' first" >&2
			exit 1
		fi

	else
		echo "ERROR: provider proxy binary not found at ${PROXY_BINARY}" >&2 
		echo "Run 'make build-proxy' to compile it" >&2 
		exit 1
	fi
fi

# ─── Build image if needed ───────────────────────────────────
if [[ -z "$(docker images -q "${IMAGE_TAG}" 2>/dev/null)" ]]; then
    echo "Building clanker image..." >&2
    docker build -t "${IMAGE_TAG}" "${SCRIPT_DIR}"
fi


# ─── Environment ─────────────────────────────────────────────
ENV_VARS=(
    -e CLANKER_PROVIDER="${CLANKER_PROVIDER:-deepseek}"
	-e CLANKER_PROVIDER_MODE="direct"
	#-e CLANKER_PROVIDER_MODE="socket"
	-e CLANKER_PROVIDER_SOCKET="/var/run/provider.sock"
    -e CLANKER_MODEL="${CLANKER_MODEL:-deepseek-chat}"
    -e CLANKER_PROVIDER_KEY_FILE="/run/secrets/provider.key"
    -e CLANKER_PROJECT_NAME="$(basename "${PROJECT_ROOT}")"
    -e CLANKER_SESSION_ID="${CONTAINER_NAME}"
    # Pass through terminal capabilities
    -e TERM="${TERM:-xterm-256color}"
    -e LINES="${LINES:-}"
    -e COLUMNS="${COLUMNS:-}"
	-e CLANKER_UID="$(id -u)"
    -e CLANKER_GID="$(id -g)"
)


# ─── Launch ──────────────────────────────────────────────────
echo "╔══════════════════════════════════════════════════════════╗"
echo "║  clanker - agent environment                             ║"
echo "╠══════════════════════════════════════════════════════════╣"
echo "║  Project: ${PROJECT_ROOT}                                ║"
echo "║  Provider: ${CLANKER_PROVIDER:-deepseek}                 ║"
echo "║  Model: ${CLANKER_MODEL:-deepseek-chat}                  ║"
echo "║  Container: ${CONTAINER_NAME}                            ║"
echo "║  Network: isolated (socket proxy only)                   ║"
echo "║  Type 'exit' to leave, Ctrl-D to detach                  ║"
echo "╚══════════════════════════════════════════════════════════╝"

exec docker run \
    --rm \
    --name "${CONTAINER_NAME}" \
    --hostname clanker \
    ${NETWORK} \
    ${SECRET_MOUNT} \
    ${SOCKET_MOUNT} \
    "${ENV_VARS[@]}" \
    "${MOUNTS[@]}" \
    -it \
    "${IMAGE_TAG}" \
    /bin/bash --rcfile /etc/clanker/bashrc
