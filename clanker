#!/usr/bin/env bash
set -euo pipefail

# ─── Configuration ───────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VERSION="$(git -C "${SCRIPT_DIR}" rev-parse --short HEAD 2>/dev/null || echo "dev")"
IMAGE_TAG="clanker:latest"
CONTAINER_NAME="clanker-$(date +%Y%m%d-%H%M%S)-$$"
PROJECT_ROOT="${CLANKER_PROJECT:-$(pwd)}"
CLANKER_CACHE="${CLANKER_CACHE:-${HOME}/.cache/clanker}"
SECRETS_DIR="${CLANKER_SECRETS_DIR:-${HOME}/.config/clanker/secrets}"
GLOBAL_SKILLS="${SCRIPT_DIR}/skills"
SKILLS_DIR="${CLANKER_SKILLS_DIR:-${PROJECT_ROOT}/.clanker}"
UNAME_S="$(uname -s)"

# ─── Argument Parsing ────────────────────────────────────────
START_PROXY=true
STOP_PROXY_ON_EXIT=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stop-proxy)   STOP_PROXY_ON_EXIT=true; START_PROXY=true; shift ;;
        --no-proxy)     START_PROXY=false; shift ;;
        --start-proxy)  START_PROXY=true; shift ;;
        --version)      echo "clanker ${VERSION}"; exit 0 ;;
        *)              break ;;
    esac
done

# ─── Preflight ───────────────────────────────────────────────
mkdir -p "${CLANKER_CACHE}/pip" "${CLANKER_CACHE}/npm" "${SECRETS_DIR}"

if [[ ! -d "${PROJECT_ROOT}" ]]; then
    echo "Error: PROJECT_ROOT ${PROJECT_ROOT} does not exist" >&2
    exit 1
fi

# Get rid of inconvenient characters in project name
sanitize_project_name() {
    local name="$1"
    # Replace anything not alphanumeric, dash, underscore with underscore
    echo "$name" | sed 's/[^a-zA-Z0-9_-]/_/g'
}
PROJECT_NAME="$(sanitize_project_name "$(basename "$PROJECT_ROOT")")"

# ─── Session (for history) ───────────────────────────────────────────────
SESSION_ID="$(date +%Y%m%d-%H%M%S)-$$"
SESSION_FILE="${CLANKER_CACHE}/sessions/${PROJECT_NAME}/${SESSION_ID}.jsonl"

# Write container name for neovim plugin
echo "$CONTAINER_NAME" > "${CLANKER_CACHE}/current-container"
trap 'rm -f "${CLANKER_CACHE}/current-container"' EXIT

# ─── Proxy Management (Platform-Specific) ────────────────────
PROXY_SERVICE="com.clanker.provider-proxy"      # launchd label
SYSTEMD_UNIT="clanker-proxy.service"            # systemd user unit
PROXY_SOCKET_PATH="${CLANKER_PROVIDER_SOCKET:-${HOME}/.cache/clanker/provider.sock}"
PROXY_TCP_PORT=11434

proxy_health_check() {
    if [[ "$UNAME_S" == "Darwin" ]]; then
        curl -fsS --max-time 2 "http://127.0.0.1:${PROXY_TCP_PORT}/health" >/dev/null 2>&1
    else
        [[ -S "$PROXY_SOCKET_PATH" ]]
    fi
}

proxy_start() {
    if [[ "$UNAME_S" == "Darwin" ]]; then
        launchctl list "$PROXY_SERVICE" >/dev/null 2>&1 || \
            launchctl bootstrap gui/$(id -u) "$HOME/Library/LaunchAgents/${PROXY_SERVICE}.plist"
        launchctl kickstart -k gui/$(id -u)/$PROXY_SERVICE
    else
        systemctl --user start "$SYSTEMD_UNIT"
    fi
}

proxy_stop() {
    if [[ "$UNAME_S" == "Darwin" ]]; then
        launchctl bootout gui/$(id -u)/$PROXY_SERVICE 2>/dev/null || true
    else
        systemctl --user stop "$SYSTEMD_UNIT"
    fi
}

# Decide connection mode and ensure proxy is up
if [[ "$UNAME_S" == "Darwin" ]]; then
    CLANKER_PROVIDER_MODE="tcp"
    CLANKER_PROVIDER_ENDPOINT="http://host.docker.internal:${PROXY_TCP_PORT}"
    CLANKER_PROVIDER_SOCKET=""
    NETWORK=""   # default bridge, host.docker.internal works
    SOCKET_MOUNT=""
else
    CLANKER_PROVIDER_MODE="socket"
    CLANKER_PROVIDER_SOCKET="/var/run/provider.sock"
    CLANKER_PROVIDER_ENDPOINT=""
    NETWORK="--network none"
    SOCKET_MOUNT="-v ${PROXY_SOCKET_PATH}:${CLANKER_PROVIDER_SOCKET}:rw"
fi

if [[ "$START_PROXY" == true ]]; then
    if ! proxy_health_check; then
        echo "  Proxy not running. Starting service..."
        proxy_start
        # Wait up to 5 seconds for health
        for _ in {1..10}; do
            sleep 0.5
            proxy_health_check && break
        done
        if ! proxy_health_check; then
            echo "  WARNING: Proxy failed to start. Agent will be offline." >&2
            CLANKER_PROVIDER_MODE="offline"
            CLANKER_PROVIDER_SOCKET=""
            CLANKER_PROVIDER_ENDPOINT=""
        fi
    else
        echo "  Proxy already running."
    fi
elif [[ "$START_PROXY" == false ]]; then
    CLANKER_PROVIDER_MODE="offline"
    CLANKER_PROVIDER_SOCKET=""
    CLANKER_PROVIDER_ENDPOINT=""
fi

# ─── Mounts ─────────────────────────────────────────────────
MOUNT_OPTS="rw"
if [[ "$UNAME_S" == "Darwin" ]]; then
    MOUNT_OPTS="rw,delegated"
fi

MOUNTS=(
    -v "${PROJECT_ROOT}:/workspace:${MOUNT_OPTS}"
    -v "${CLANKER_CACHE}/pip:/home/clanker/.cache/pip:rw"
    -v "${CLANKER_CACHE}/npm:/home/clanker/.cache/npm:rw"
    -v "${CLANKER_CACHE}/sessions:/home/clanker/.clanker/sessions:rw"
    -v "${GLOBAL_SKILLS}:/etc/clanker/skills:ro"
)

# Project-specific skills
if [[ -d "${SKILLS_DIR}/skills" ]]; then
    MOUNTS+=(-v "${SKILLS_DIR}/skills:/workspace/.clanker/skills:ro")
fi
if [[ -f "${SKILLS_DIR}/config" ]]; then
    MOUNTS+=(-v "${SKILLS_DIR}/config:/workspace/.clanker/config:ro")
fi
# Shadow .venv if present
if [[ -d "${PROJECT_ROOT}/.venv" ]]; then
    MOUNTS+=(-v "clanker-venv-$(basename "${PROJECT_ROOT}"):/workspace/.venv")
fi

# ─── Secrets (API Key) ───────────────────────────────────────
SECRET_MOUNT="--tmpfs /run/secrets:mode=0700,size=1M"
PROVIDER_KEY_FILE="${CLANKER_PROVIDER_KEY_FILE:-${SECRETS_DIR}/provider.key}"
if [[ -f "${PROVIDER_KEY_FILE}" ]]; then
    TMP_KEY="$(mktemp)"
    trap 'rm -f "${TMP_KEY}"' EXIT
    cp "${PROVIDER_KEY_FILE}" "${TMP_KEY}"
    MOUNTS+=(-v "${TMP_KEY}:/run/secrets/provider.key:ro")
fi

# ─── Environment ────────────────────────────────────────────
ENV_VARS=(
    -e CLANKER_PROVIDER="${CLANKER_PROVIDER:-deepseek}"
    -e CLANKER_PROVIDER_MODE="${CLANKER_PROVIDER_MODE}"
    -e CLANKER_PROVIDER_SOCKET="${CLANKER_PROVIDER_SOCKET}"
    -e CLANKER_PROVIDER_ENDPOINT="${CLANKER_PROVIDER_ENDPOINT}"
    -e CLANKER_MODEL="${CLANKER_MODEL:-deepseek-chat}"
    -e CLANKER_PROVIDER_KEY_FILE="/run/secrets/provider.key"
    -e CLANKER_PROJECT_NAME="$(basename "${PROJECT_NAME}")"
    #-e CLANKER_PROJECT_NAME="$(basename "${PROJECT_ROOT}")"
    -e CLANKER_SESSION_ID="${CONTAINER_NAME}"
    -e CLANKER_UID="$(id -u)"
    -e CLANKER_GID="$(id -g)"
    -e TERM="${TERM:-xterm-256color}"
    -e LINES="${LINES:-}"
    -e COLUMNS="${COLUMNS:-}"
)

# ─── Build Image if Needed ──────────────────────────────────
if [[ -z "$(docker images -q "${IMAGE_TAG}" 2>/dev/null)" ]]; then
    echo "Building clanker image..."
    docker build -t "${IMAGE_TAG}" "${SCRIPT_DIR}"
fi

# ─── Launch ─────────────────────────────────────────────────
echo "╔══════════════════════════════════════════════════════════╗"
echo "║  clanker - agent environment                             ║"
echo "╠══════════════════════════════════════════════════════════╣"
echo "║  Project:   ${PROJECT_ROOT}"
echo "║  Provider:  ${CLANKER_PROVIDER:-deepseek}"
echo "║  Model:     ${CLANKER_MODEL:-deepseek-chat}"
echo "║  Mode:      ${CLANKER_PROVIDER_MODE}"
echo "║  Socket:    ${CLANKER_PROVIDER_SOCKET}"
echo "║  Endpoint:  ${CLANKER_PROVIDER_ENDPOINT}"
echo "║  Container: ${CONTAINER_NAME}"
echo "╚══════════════════════════════════════════════════════════╝"

docker run \
    --rm \
    --name "${CONTAINER_NAME}" \
    --hostname clanker \
    ${NETWORK} \
    ${SECRET_MOUNT} \
    ${SOCKET_MOUNT} \
    "${ENV_VARS[@]}" \
    "${MOUNTS[@]}" \
    -it \
    "${IMAGE_TAG}" \
    /bin/bash --rcfile /etc/clanker/bashrc

STATUS=$?

if [[ "$STOP_PROXY_ON_EXIT" == true ]] && [[ "$START_PROXY" == true ]]; then
    echo "  Stopping proxy service..."
    proxy_stop
fi

exit $STATUS
