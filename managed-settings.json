{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",

    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.git-credentials)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(/etc/claude-code/**)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],

    "allow": [
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(ctest *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(pytest *)",
      "Bash(uv run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(rg *)"
    ]
  },

  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "disableSideloadFlags": true,
  "disableSkillShellExecution": true,

  "allowedMcpServers": [],
  "disableClaudeAiConnectors": true,

  "minimumVersion": "2.1.200",
  "autoUpdatesChannel": "stable",

  "claudeMd": "You are running unattended in a container. /workspace is a scratch worktree; commit to the working branch and stop. Never push. If the build or tests cannot run, report that and stop rather than modifying build configuration to make them pass.",

  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "USE_BUILTIN_RIPGREP": "0"
  }
}
